{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Thread",
  "version": "0.1.0",
  "identifier": "com.lariccia.thread",
  "build": {
    "beforeDevCommand": {
      "cwd": "../..",
      "script": "npm run dev"
    },
    "beforeBuildCommand": {
      "cwd": "../..",
      "script": "npm run build"
    },
    "devUrl": "http://localhost:5174",
    "frontendDist": "../../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Thread",
        "width": 960,
        "height": 600,
        "minWidth": 520,
        "minHeight": 360,
        "resizable": true,
        "decorations": false,
        "theme": "Dark",
        "transparent": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
